# Genie Cloud Frontend Environment Variables Example
# Copy this file to .env and configure the variables.

# The environment the app is running in (local, staging, production)
VITE_APP_ENV=local

# Base URL of the backend API
VITE_API_BASE_URL=http://backend.test

# Subdomain to enforce/mock for the tenant workspace (optional, for testing or dedicated subdomain setups)
# Leave blank to dynamically parse the tenant from the Host header or subdomains
VITE_TENANT_SUBDOMAIN=
